{
 "uid": "sbq-app",
 "title": "Spring Boot vs Quarkus: app",
 "timezone": "utc",
 "schemaVersion": 39,
 "refresh": "1s",
 "time": {
  "from": "now-5m",
  "to": "now"
 },
 "timepicker": {
  "refresh_intervals": [
   "1s",
   "5s"
  ]
 },
 "panels": [
  {
   "type": "stat",
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0,
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "#E6E6E6"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^spring-jvm( .*)?$"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#6DB33F"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^spring-native( .*)?$"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#B8E986"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^quarkus-jvm( .*)?$"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#4695EB"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^quarkus-native( .*)?$"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#FF4F5E"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".* (p95|busy)$"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          8
         ]
        }
       },
       {
        "id": "custom.fillOpacity",
        "value": 0
       }
      ]
     }
    ]
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value_and_name",
    "justifyMode": "center"
   },
   "id": 1,
   "title": "requests / s",
   "targets": [
    {
     "refId": "A",
     "expr": "(sum by (app) (rate(k6_http_reqs_total[5s]))) and on(app) sbq_phase{app!=\"none\"}",
     "legendFormat": "{{app}}"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 3
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   }
  },
