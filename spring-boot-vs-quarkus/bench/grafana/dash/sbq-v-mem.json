{
 "uid": "sbq-v-mem",
 "title": "sbq video mem",
 "timezone": "utc",
 "schemaVersion": 39,
 "refresh": "1s",
 "time": {
  "from": "now-5m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "container memory (working set, as docker stats)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 27
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(max by (app) (label_replace(container_memory_working_set_bytes{name=~\"sbq-.*\"}, \"app\", \"$1\", \"name\", \"sbq-(.*)\"))) and on(app) sbq_phase{app!=\"none\"}",
     "legendFormat": "{{app}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "min": 0,
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 4,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": false,
      "insertNulls": 60000,
      "axisSoftMin": 0
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "spring-jvm"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#6DB33F"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "spring-native"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#B8E986"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "quarkus-jvm"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#4695EB"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "quarkus-native"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#FF4F5E"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "none"
    }
   }
  }
 ],
 "templating": {
  "list": []
 }
}